#include <stdio.h>
#include <string.h>

typedef struct {
    int maNV;
    char hoTen[50];
    char ngaySinh[15];
    float luong;
} NhanVien;

void nhap(NhanVien a[], int n) {
    int i;

    for (i = 0; i < n; i++) {
        printf("\nNhap nhan vien thu %d:\n", i + 1);

        printf("Ma nhan vien: ");
        scanf("%d", &a[i].maNV);

        getchar();

        printf("Ho ten: ");
        fgets(a[i].hoTen, sizeof(a[i].hoTen), stdin);
        a[i].hoTen[strcspn(a[i].hoTen, "\n")] = '\0';

        printf("Ngay sinh (dd/mm/yyyy): ");
        fgets(a[i].ngaySinh, sizeof(a[i].ngaySinh), stdin);
        a[i].ngaySinh[strcspn(a[i].ngaySinh, "\n")] = '\0';

        printf("Luong (trieu dong): ");
        scanf("%f", &a[i].luong);
    }
}

void xuat(NhanVien a[], int n) {
    int i;

    printf("\n%-10s %-25s %-15s %-15s\n",
           "Ma NV", "Ho ten", "Ngay sinh", "Luong");

    for (i = 0; i < n; i++) {
        printf("%-10d %-25s %-15s %-15.2f\n",
               a[i].maNV,
               a[i].hoTen,
               a[i].ngaySinh,
               a[i].luong);
    }
}

void bubbleSort(NhanVien a[], int n) {
    int i, j;
    NhanVien temp;

    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (a[j].luong > a[j + 1].luong) {
                temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
    }
}

void timKiemNhiPhan(NhanVien a[], int n, float x) {
    int left = 0;
    int right = n - 1;
    int found = 0;

    while (left <= right) {
        int mid = (left + right) / 2;

        if (a[mid].luong == x) {
            int i;

            printf("\nCac nhan vien co luong bang %.2f trieu dong:\n", x);

            i = mid;
            while (i >= 0 && a[i].luong == x) {
                i--;
            }

            i++;

            while (i < n && a[i].luong == x) {
                printf("Ma NV: %d | Ho ten: %s | Ngay sinh: %s | Luong: %.2f\n",
                       a[i].maNV,
                       a[i].hoTen,
                       a[i].ngaySinh,
                       a[i].luong);
                i++;
            }

            found = 1;
            break;
        }
        else if (a[mid].luong < x) {
            left = mid + 1;
        }
        else {
            right = mid - 1;
        }
    }

    if (found == 0) {
        printf("\nKhong tim thay nhan vien co luong bang %.2f\n", x);
    }
}

int main() {
    NhanVien a[100];
    int n;
    float x;

    printf("Nhap so luong nhan vien: ");
    scanf("%d", &n);

    nhap(a, n);

    printf("\n===== DANH SACH NHAN VIEN VUA NHAP =====\n");
    xuat(a, n);

    bubbleSort(a, n);

    printf("\n===== DANH SACH SAU KHI SAP XEP =====\n");
    xuat(a, n);

    printf("\nNhap muc luong can tim X: ");
    scanf("%f", &x);

    timKiemNhiPhan(a, n, x);

    return 0;
}
